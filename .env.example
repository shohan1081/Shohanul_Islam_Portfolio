# Copy this file to .env and fill in real values. .env is gitignored and
# never committed — this .example file is just a template documenting what's
# needed.

# Gmail account used to SEND contact-form emails (must have an App Password
# generated at https://myaccount.google.com/apppasswords — a regular Gmail
# password will NOT work here since 2FA-protected accounts require an app
# password for SMTP).
EMAIL_HOST_USER=your-gmail-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password

# Inbox where contact-form submissions should actually land. Defaults to
# EMAIL_HOST_USER if left blank.
CONTACT_RECIPIENT_EMAIL=where-you-actually-check-email@gmail.com
